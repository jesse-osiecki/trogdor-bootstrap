 # Because of flashing IR emitters, some frames can be completely unlit
+# Minimum score for the HOG face detector (ignored when use_cnn is true)
+# 0 is dlib's default; negative values (down to about -1) also accept faces
+# that are backlit, in shadow or seen from a low angle. The face still has
+# to match the model with the certainty above, so this only costs CPU time
+# on frames without a face
+detection_threshold = 0
+
