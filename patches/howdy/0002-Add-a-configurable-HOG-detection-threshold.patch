diff --git a/howdy/src/detector.py b/howdy/src/detector.py
new file mode 100644
index 0000000..49b2270
--- /dev/null
+++ b/howdy/src/detector.py
@@ -0,0 +1,33 @@
+# Face detector construction shared by compare.py, the CLI and the rubber
+# stamps, so every path applies the same configuration.
+
+import dlib
+import paths_factory
+
+
+class hog_face_detector:
+	"""
+	dlib's HOG frontal face detector with a configurable score threshold.
+
+	Called as a plain detector it only returns faces scoring above 0. A face
+	that is backlit, in shadow or seen from below often scores between -1 and
+	0 while still being perfectly usable: the landmarks land and the
+	recognition model still has the final say on whether it is the user.
+	detection_threshold in the [video] section moves that cutoff; 0 keeps
+	dlib's default.
+	"""
+
+	def __init__(self, threshold=0.0):
+		self.detector = dlib.get_frontal_face_detector()
+		self.threshold = float(threshold)
+
+	def __call__(self, image, upsample_num_times=0):
+		rects, _scores, _idx = self.detector.run(image, upsample_num_times, self.threshold)
+		return rects
+
+
+def load_face_detector(config):
+	"""Build the detector selected by the config (CNN or HOG)"""
+	if config.getboolean("core", "use_cnn", fallback=False):
+		return dlib.cnn_face_detection_model_v1(paths_factory.mmod_human_face_detector_path())
+	return hog_face_detector(config.getfloat("video", "detection_threshold", fallback=0.0))
