diff --git a/howdy/src/recorders/pipewire_reader.py b/howdy/src/recorders/pipewire_reader.py
new file mode 100644
index 0000000..a6e6b6f
--- /dev/null
+++ b/howdy/src/recorders/pipewire_reader.py
@@ -0,0 +1,168 @@
+# Frame reader that pulls video from PipeWire through GStreamer.
+#
+# Some cameras only exist behind libcamera (raw MIPI CSI sensors on Qualcomm
+# camss, for example): there is no V4L2 node that hands out finished frames,
+# and the libcamera pipeline can only be held by one process. On a desktop
+# that process is PipeWire's libcamera plugin, so the way to get frames is to
+# be a PipeWire client. This reader does that with pipewiresrc and an appsink
+# and presents the same tiny API compare.py expects from cv2.VideoCapture.
+
+import os
+import pwd
+import sys
+
+import numpy
+from cv2 import CAP_PROP_FRAME_WIDTH
+from cv2 import CAP_PROP_FRAME_HEIGHT
+from i18n import _
+
+try:
+	import gi
+	gi.require_version("Gst", "1.0")
+	gi.require_version("GstApp", "1.0")
+	from gi.repository import Gst, GstApp  # noqa: F401  (GstApp registers appsink methods)
+except (ImportError, ValueError):
+	print(_("Missing GStreamer python bindings, please install python3-gi (py3-gobject3) and gst-plugins-base"))
+	sys.exit(12)
+
+
+def _find_pipewire_runtime_dir():
+	"""
+	PipeWire locates its socket through PIPEWIRE_RUNTIME_DIR or
+	XDG_RUNTIME_DIR. Under sudo/doas/pkexec (howdy add, howdy test) those
+	point at root's session, not the desktop user's, so fall back to the
+	invoking user's /run/user/<uid>.
+	"""
+	for var in ("PIPEWIRE_RUNTIME_DIR", "XDG_RUNTIME_DIR"):
+		d = os.environ.get(var)
+		if d and os.path.exists(os.path.join(d, "pipewire-0")):
+			return
+
+	uid = None
+	for var in ("SUDO_UID", "PKEXEC_UID"):
+		if os.environ.get(var):
+			uid = int(os.environ[var])
+			break
+	if uid is None:
+		for var in ("SUDO_USER", "DOAS_USER"):
+			if os.environ.get(var):
+				uid = pwd.getpwnam(os.environ[var]).pw_uid
+				break
+	if uid is None:
+		uid = os.getuid()
+
+	d = "/run/user/%d" % uid
+	if os.path.exists(os.path.join(d, "pipewire-0")):
+		os.environ["PIPEWIRE_RUNTIME_DIR"] = d
+
+
+class pipewire_reader:
+	"""Looks like the subset of cv2.VideoCapture that Howdy uses."""
+
+	def __init__(self, target="", timeout=5.0):
+		# PipeWire node name or object.serial of the camera; empty means the default camera
+		self.target = target
+		# Seconds to wait for the pipeline to start / for a single frame
+		self.timeout = timeout
+		self.pipeline = None
+		self.sink = None
+		self.width = 0
+		self.height = 0
+		self.req_width = -1
+		self.req_height = -1
+
+	def set(self, prop, setting):
+		"""Remember a requested size; applied when the pipeline starts"""
+		if prop == CAP_PROP_FRAME_WIDTH:
+			self.req_width = int(setting)
+		elif prop == CAP_PROP_FRAME_HEIGHT:
+			self.req_height = int(setting)
+		# Every other property (fps, fourcc, exposure) has no meaning here
+
+	def get(self, prop):
+		"""Negotiated frame size"""
+		self._start()
+		if prop == CAP_PROP_FRAME_WIDTH:
+			return self.width
+		elif prop == CAP_PROP_FRAME_HEIGHT:
+			return self.height
+		return 0
+
+	def _start(self):
+		if self.pipeline is not None:
+			return
+
+		_find_pipewire_runtime_dir()
+		Gst.init(None)
+
+		src = "pipewiresrc do-timestamp=true"
+		if self.target:
+			src += ' target-object="%s"' % self.target
+		caps = "video/x-raw,format=BGR"
+		if self.req_width > 0:
+			caps += ",width=%d" % self.req_width
+		if self.req_height > 0:
+			caps += ",height=%d" % self.req_height
+		desc = "%s ! videoconvert ! %s ! appsink name=sink max-buffers=1 drop=true sync=false" % (src, caps)
+
+		try:
+			self.pipeline = Gst.parse_launch(desc)
+		except Exception as err:
+			print(_("Failed to build the PipeWire capture pipeline: {}").format(err))
+			sys.exit(14)
+		self.sink = self.pipeline.get_by_name("sink")
+
+		self.pipeline.set_state(Gst.State.PLAYING)
+		ret, _state, _pending = self.pipeline.get_state(int(self.timeout * Gst.SECOND))
+		if ret == Gst.StateChangeReturn.FAILURE:
+			print(_("Failed to open the PipeWire camera{}, is pipewire running for this user?").format(" " + self.target if self.target else ""))
+			self.release()
+			sys.exit(14)
+
+		# Pull one sample so the size is known before compare.py asks for it
+		sample = self.sink.try_pull_sample(int(self.timeout * Gst.SECOND))
+		if sample is None:
+			print(_("No frames arrived from PipeWire within {} seconds").format(self.timeout))
+			self.release()
+			sys.exit(14)
+		self._sample_to_frame(sample)
+
+	def _sample_to_frame(self, sample):
+		caps = sample.get_caps().get_structure(0)
+		self.width = caps.get_value("width")
+		self.height = caps.get_value("height")
+
+		buf = sample.get_buffer()
+		ok, info = buf.map(Gst.MapFlags.READ)
+		if not ok:
+			return None
+		try:
+			# GStreamer pads BGR rows to a 4-byte stride, so index by stride and trim
+			stride = info.size // self.height
+			flat = numpy.frombuffer(info.data, dtype=numpy.uint8, count=stride * self.height)
+			frame = flat.reshape((self.height, stride))[:, :self.width * 3].reshape((self.height, self.width, 3)).copy()
+		finally:
+			buf.unmap(info)
+		return frame
+
+	def read(self):
+		"""Return (ok, frame) like cv2.VideoCapture.read"""
+		self._start()
+		sample = self.sink.try_pull_sample(int(self.timeout * Gst.SECOND))
+		if sample is None:
+			return False, None
+		frame = self._sample_to_frame(sample)
+		return frame is not None, frame
+
+	def grab(self):
+		"""Wake the camera up and discard a frame"""
+		self.read()
+
+	def release(self):
+		if self.pipeline is not None:
+			self.pipeline.set_state(Gst.State.NULL)
+			self.pipeline = None
+			self.sink = None
+
+	def __del__(self):
+		self.release()
