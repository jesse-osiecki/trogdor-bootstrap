From abddad813b4b4f556f6ceb7223b1a5c92dd4c475 Mon Sep 17 00:00:00 2001
From: Jesse Osiecki <jesse@jjo.ninja>
Date: Sun, 13 Sep 2026 18:46:42 -0400
Subject: [PATCH 4/4] nod stamp: follow the face that authenticated

The nod stamp required exactly one detection per frame. With a
detection_threshold below 0 the detector also reports low-scoring
non-faces (a shirt logo, the frame edge), so nearly every frame was
skipped and a nod could never be seen. compare.py now passes the
matched face's rectangle (native coordinates) to the stamps and the nod
stamp follows the candidate that overlaps it from frame to frame,
falling back to the old exactly-one rule when no seed is available.
This also means only the face that authenticated can perform the nod.
---
 howdy/src/compare.py          | 11 ++++++++-
 howdy/src/rubberstamps/nod.py | 42 ++++++++++++++++++++++++++++++-----
 2 files changed, 46 insertions(+), 7 deletions(-)

diff --git a/howdy/src/compare.py b/howdy/src/compare.py
index 0a10299..ddebba7 100644
--- a/howdy/src/compare.py
+++ b/howdy/src/compare.py
@@ -373,11 +373,20 @@ while True:
 				if "gtk_proc" not in vars():
 					gtk_proc = None
 
+				# Where the matching face is, in native frame coordinates, so a
+				# stamp can keep following that face rather than any detection
+				face_location = None
+				if rotate == 0:
+					face_location = dlib.rectangle(
+						int(fl.left() / scaling_factor), int(fl.top() / scaling_factor),
+						int(fl.right() / scaling_factor), int(fl.bottom() / scaling_factor))
+
 				rubberstamps.execute(config, gtk_proc, {
 					"video_capture": video_capture,
 					"face_detector": face_detector,
 					"pose_predictor": pose_predictor,
-					"clahe": clahe
+					"clahe": clahe,
+					"face_location": face_location
 				})
 
 			# End peacefully
diff --git a/howdy/src/rubberstamps/nod.py b/howdy/src/rubberstamps/nod.py
index d1fdb68..5532684 100644
--- a/howdy/src/rubberstamps/nod.py
+++ b/howdy/src/rubberstamps/nod.py
@@ -6,12 +6,41 @@ from i18n import _
 from rubberstamps import RubberStamp
 
 
+def _overlap(a, b):
+	"""Intersection over union of two dlib rectangles"""
+	iw = min(a.right(), b.right()) - max(a.left(), b.left())
+	ih = min(a.bottom(), b.bottom()) - max(a.top(), b.top())
+	if iw <= 0 or ih <= 0:
+		return 0.0
+	inter = iw * ih
+	return inter / float(a.area() + b.area() - inter)
+
+
 class nod(RubberStamp):
 	def declare_config(self):
 		"""Set the default values for the optional arguments"""
 		self.options["min_distance"] = 6
 		self.options["min_directions"] = 2
 
+	def pick_face(self, faces, last_face):
+		"""
+		Choose the face to track in this frame.
+
+		A tolerant detector (detection_threshold below 0) can report several
+		candidate rectangles, most of them not faces. When we know where the
+		authenticated face was, follow the candidate that overlaps it; without
+		that knowledge fall back to requiring exactly one face in the frame.
+		"""
+		faces = [f.rect if hasattr(f, "rect") else f for f in faces]
+		if last_face is None:
+			return faces[0] if len(faces) == 1 else None
+		best, best_overlap = None, 0.0
+		for face in faces:
+			overlap = _overlap(face, last_face)
+			if overlap > best_overlap:
+				best, best_overlap = face, overlap
+		return best if best_overlap >= 0.3 else None
+
 	def run(self):
 		"""Track a users nose to see if they nod yes or no"""
 		self.set_ui_text(_("Nod to confirm"), self.UI_TEXT)
@@ -24,6 +53,8 @@ class nod(RubberStamp):
 		last_nosepoint = {"x": -1, "y": -1}
 		# Contains booleans recording successful nods and their directions
 		recorded_nods = {"x": [], "y": []}
+		# The face that authenticated, if compare.py told us; updated every frame
+		last_face = self.opencv.get("face_location")
 
 		starttime = time.time()
 
@@ -35,15 +66,14 @@ class nod(RubberStamp):
 			# Apply CLAHE to get a better picture
 			frame = self.clahe.apply(frame)
 
-			# Detect all faces in the frame
-			face_locations = self.face_detector(frame, 1)
-
-			# Only continue if exactly 1 face is visible in the frame
-			if len(face_locations) != 1:
+			# Detect all faces in the frame and keep following the one we know
+			face = self.pick_face(self.face_detector(frame, 1), last_face)
+			if face is None:
 				continue
+			last_face = face
 
 			# Get the position of the eyes and tip of the nose
-			face_landmarks = self.pose_predictor(frame, face_locations[0])
+			face_landmarks = self.pose_predictor(frame, face)
 
 			# Calculate the relative distance between the 2 eyes
 			reldist = face_landmarks.part(0).x - face_landmarks.part(2).x
-- 
