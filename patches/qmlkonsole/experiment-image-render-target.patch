@@ -360,9 +360,22 @@
     _scrollBar->setVisible(false);
     connect(_scrollBar, &QAbstractSlider::valueChanged, this, &TerminalDisplay::scrollbarParamsChanged);
 
-    // TODO Forcing rendering to Framebuffer. We need to determine if this is ok
-    // always or if we need to make this customizable.
-    setRenderTarget(QQuickPaintedItem::FramebufferObject);
+    // Render into an image rather than a framebuffer object.
+    //
+    // With an FBO the item is rendered on the scene graph's render thread and
+    // the resulting texture is then sampled to composite the item. On the
+    // Adreno 618 / freedreno stack that texture can be sampled before the GPU
+    // has finished rasterising it, and because the item is drawn as a quad --
+    // two triangles -- what shows up is the terminal on one side of the quad's
+    // diagonal and stale or empty content on the other. The result is large
+    // diagonal wedges across the view that no amount of repainting clears,
+    // because the pixels are painted correctly and it is the compositing step
+    // that is wrong. Only a resize clears them, by reallocating the texture.
+    //
+    // The image render target paints on the CPU and uploads an ordinary
+    // texture, which has no such race. This also answers the TODO that has sat
+    // here since the code was imported from QMLTermWidget.
+    setRenderTarget(QQuickPaintedItem::Image);
 
