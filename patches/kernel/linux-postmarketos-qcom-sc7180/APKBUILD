	0019-dt-bindings-media-i2c-ovti-ov5675-ovti-ov8856-Allow-.patch
	0020-arm64-dts-qcom-sc7180-camss-Add-CAMSS-block-definiti.patch
	0021-arm64-dts-qcom-sc7180-Add-CCI0-camera-control-interf.patch
	0022-arm64-dts-qcom-sc7180-trogdor-wormdingler-Add-MIPI-c.patch
	0023-i2c-qcom-cci-Remove-unused-CCI_RES_MAX-macro-definit.patch
	0024-i2c-qcom-cci-Do-not-check-return-value-of-cci_init.patch
	0025-i2c-qcom-cci-Move-cci_init-under-cci_reset-function.patch
