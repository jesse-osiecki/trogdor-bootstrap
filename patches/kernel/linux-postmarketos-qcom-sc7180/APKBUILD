	0009-media-qcom-camss-Add-sc7180-support.patch
	0010-media-qcom-camss-Add-sc7180-resources.patch
	0011-media-qcom-camss-sc7180-Add-interconnect-support.patch
	0012-media-qcom-camss-sc7180-Request-CSIPHY-vdda-phy-and-.patch
	0013-clk-qcom-gcc-sc7180-Skip-halt-check-for-gcc_camera_h.patch
	0014-media-i2c-ov8856-Report-the-active-media-bus-code-fr.patch
	0015-media-i2c-ov8856-Implement-get_selection.patch
