diff --git a/device/community/linux-postmarketos-qcom-sc7180/0014-media-i2c-ov8856-Report-the-active-media-bus-code-fr.patch b/device/community/linux-postmarketos-qcom-sc7180/0014-media-i2c-ov8856-Report-the-active-media-bus-code-fr.patch
new file mode 100644
index 0000000..dbfccc9
--- /dev/null
+++ b/device/community/linux-postmarketos-qcom-sc7180/0014-media-i2c-ov8856-Report-the-active-media-bus-code-fr.patch
@@ -0,0 +1,44 @@
+From a4fabce947b3232f35b2553f0b3a5be379d15341 Mon Sep 17 00:00:00 2001
+From: Jesse <jesse@jjo.ninja>
+Date: Thu, 3 Sep 2026 08:49:35 -0400
+Subject: [PATCH 14/28] media: i2c: ov8856: Report the active media bus code
+ from get_fmt
+
+ov8856_get_format() calls ov8856_update_pad_format() with whatever
+code the caller left in fmt->format.code. For an unknown (typically
+zero) code that helper falls back to the mode's default code and, as a
+side effect, overwrites cur_mbus_index. With the sensor configured for
+SBGGR10 on a mode whose default is SGRBG10, link validation reads the
+pad format with a zeroed struct, gets SGRBG10 back and fails with
+-EPIPE:
+
+  v4l2_subdev_link_validate_default: media bus code does not match (source 0x0000300a, sink 0x00003007)
+  link was "ov8856 15-0010":0 -> "msm_csiphy1":0
+
+Seed the code from cur_mbus_index so get_fmt is idempotent and returns
+the format that was actually set.
+Signed-off-by: Jesse <jesse@jjo.ninja>
+---
+ drivers/media/i2c/ov8856.c | 6 ++++--
+ 1 file changed, 4 insertions(+), 2 deletions(-)
+
+diff --git a/drivers/media/i2c/ov8856.c b/drivers/media/i2c/ov8856.c
+index dd01e1d51..eb1251d7c 100644
+--- a/drivers/media/i2c/ov8856.c
++++ b/drivers/media/i2c/ov8856.c
+@@ -2173,11 +2173,13 @@ static int ov8856_get_format(struct v4l2_subdev *sd,
+ 	struct ov8856 *ov8856 = to_ov8856(sd);
+ 
+ 	mutex_lock(&ov8856->mutex);
+-	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
++	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+ 		fmt->format = *v4l2_subdev_state_get_format(sd_state,
+ 							    fmt->pad);
+-	else
++	} else {
++		fmt->format.code = ov8856_mbus_codes[ov8856->cur_mbus_index];
+ 		ov8856_update_pad_format(ov8856, ov8856->cur_mode, &fmt->format);
++	}
+ 
+ 	mutex_unlock(&ov8856->mutex);
+ 
diff --git a/device/community/linux-postmarketos-qcom-sc7180/0015-media-i2c-ov8856-Implement-get_selection.patch b/device/community/linux-postmarketos-qcom-sc7180/0015-media-i2c-ov8856-Implement-get_selection.patch
new file mode 100644
index 0000000..6ee63f8
--- /dev/null
+++ b/device/community/linux-postmarketos-qcom-sc7180/0015-media-i2c-ov8856-Implement-get_selection.patch
@@ -0,0 +1,75 @@
+From c4e2b8165fb92ab6901a288950a00cd72c1760c3 Mon Sep 17 00:00:00 2001
+From: Jesse <jesse@jjo.ninja>
+Date: Thu, 3 Sep 2026 08:49:36 -0400
+Subject: [PATCH 15/28] media: i2c: ov8856: Implement get_selection
+
+libcamera requires V4L2_SEL_TGT_CROP_BOUNDS/CROP_DEFAULT/CROP and
+NATIVE_SIZE on the sensor pad to derive the pixel array properties and
+otherwise warns that the driver needs fixing. Report the 3296x2480
+pixel array with the 3280x2464 active area, like ov5675 does.
+Signed-off-by: Jesse <jesse@jjo.ninja>
+---
+ drivers/media/i2c/ov8856.c | 36 ++++++++++++++++++++++++++++++++++++
+ 1 file changed, 36 insertions(+)
+
+diff --git a/drivers/media/i2c/ov8856.c b/drivers/media/i2c/ov8856.c
+index eb1251d7c..26f4bc9e2 100644
+--- a/drivers/media/i2c/ov8856.c
++++ b/drivers/media/i2c/ov8856.c
+@@ -20,6 +20,14 @@
+ #define OV8856_REG_VALUE_24BIT		3
+ 
+ #define OV8856_SCLK			144000000ULL
++/* Pixel array: 3296x2480 total, 3280x2464 active */
++#define OV8856_NATIVE_WIDTH		3296
++#define OV8856_NATIVE_HEIGHT		2480
++#define OV8856_ACTIVE_START_LEFT	8
++#define OV8856_ACTIVE_START_TOP		8
++#define OV8856_ACTIVE_WIDTH		3280
++#define OV8856_ACTIVE_HEIGHT		2464
++
+ #define OV8856_XVCLK_19_2		19200000
+ #define OV8856_DATA_LANES		4
+ #define OV8856_RGB_DEPTH		10
+@@ -2186,6 +2194,33 @@ static int ov8856_get_format(struct v4l2_subdev *sd,
+ 	return 0;
+ }
+ 
++static int ov8856_get_selection(struct v4l2_subdev *sd,
++				struct v4l2_subdev_state *state,
++				struct v4l2_subdev_selection *sel)
++{
++	if (sel->which != V4L2_SUBDEV_FORMAT_ACTIVE)
++		return -EINVAL;
++
++	switch (sel->target) {
++	case V4L2_SEL_TGT_NATIVE_SIZE:
++		sel->r.top = 0;
++		sel->r.left = 0;
++		sel->r.width = OV8856_NATIVE_WIDTH;
++		sel->r.height = OV8856_NATIVE_HEIGHT;
++		return 0;
++	case V4L2_SEL_TGT_CROP:
++	case V4L2_SEL_TGT_CROP_DEFAULT:
++	case V4L2_SEL_TGT_CROP_BOUNDS:
++		sel->r.top = OV8856_ACTIVE_START_TOP;
++		sel->r.left = OV8856_ACTIVE_START_LEFT;
++		sel->r.width = OV8856_ACTIVE_WIDTH;
++		sel->r.height = OV8856_ACTIVE_HEIGHT;
++		return 0;
++	}
++
++	return -EINVAL;
++}
++
+ static int ov8856_enum_mbus_code(struct v4l2_subdev *sd,
+ 				 struct v4l2_subdev_state *sd_state,
+ 				 struct v4l2_subdev_mbus_code_enum *code)
+@@ -2241,6 +2276,7 @@ static const struct v4l2_subdev_video_ops ov8856_video_ops = {
+ static const struct v4l2_subdev_pad_ops ov8856_pad_ops = {
+ 	.set_fmt = ov8856_set_format,
+ 	.get_fmt = ov8856_get_format,
++	.get_selection = ov8856_get_selection,
+ 	.enum_mbus_code = ov8856_enum_mbus_code,
+ 	.enum_frame_size = ov8856_enum_frame_size,
+ };
diff --git a/device/community/linux-postmarketos-qcom-sc7180/0016-media-i2c-ov8856-Don-t-power-off-an-already-suspende.patch b/device/community/linux-postmarketos-qcom-sc7180/0016-media-i2c-ov8856-Don-t-power-off-an-already-suspende.patch
new file mode 100644
index 0000000..9e53ddd
--- /dev/null
+++ b/device/community/linux-postmarketos-qcom-sc7180/0016-media-i2c-ov8856-Don-t-power-off-an-already-suspende.patch
@@ -0,0 +1,35 @@
+From f36cbda8319cee39274f3f833bca37393d24457f Mon Sep 17 00:00:00 2001
+From: Jesse <jesse@jjo.ninja>
+Date: Thu, 3 Sep 2026 08:55:17 -0400
+Subject: [PATCH 16/28] media: i2c: ov8856: Don't power off an already
+ suspended sensor on remove
+
+ov8856_remove() unconditionally calls ov8856_power_off() even when the
+device is runtime suspended and thus already powered down, which trips
+the regulator core:
+
+  WARNING: CPU: 1 PID: 7583 at drivers/regulator/core.c:3025 _regulator_disable+0x6c/0x2b0
+  ov8856_remove+0x64/0x90 [ov8856]
+
+Only power off when the device is still active, and mark it suspended
+afterwards.
+Signed-off-by: Jesse <jesse@jjo.ninja>
+---
+ drivers/media/i2c/ov8856.c | 4 +++-
+ 1 file changed, 3 insertions(+), 1 deletion(-)
+
+diff --git a/drivers/media/i2c/ov8856.c b/drivers/media/i2c/ov8856.c
+index 26f4bc9e2..e43d2c270 100644
+--- a/drivers/media/i2c/ov8856.c
++++ b/drivers/media/i2c/ov8856.c
+@@ -2401,7 +2401,9 @@ static void ov8856_remove(struct i2c_client *client)
+ 	pm_runtime_disable(ov8856->dev);
+ 	mutex_destroy(&ov8856->mutex);
+ 
+-	ov8856_power_off(ov8856->dev);
++	if (!pm_runtime_status_suspended(ov8856->dev))
++		ov8856_power_off(ov8856->dev);
++	pm_runtime_set_suspended(ov8856->dev);
+ }
+ 
+ static int ov8856_probe(struct i2c_client *client)
diff --git a/device/community/linux-postmarketos-qcom-sc7180/0017-media-i2c-ov8856-Register-the-orientation-and-rotati.patch b/device/community/linux-postmarketos-qcom-sc7180/0017-media-i2c-ov8856-Register-the-orientation-and-rotati.patch
new file mode 100644
index 0000000..a989a13
--- /dev/null
+++ b/device/community/linux-postmarketos-qcom-sc7180/0017-media-i2c-ov8856-Register-the-orientation-and-rotati.patch
@@ -0,0 +1,45 @@
+From c62fe566478aef3de46bffdc0e28aef18b932c96 Mon Sep 17 00:00:00 2001
+From: Jesse <jesse@jjo.ninja>
+Date: Thu, 3 Sep 2026 18:01:35 -0400
+Subject: [PATCH 17/28] media: i2c: ov8856: Register the orientation and
+ rotation controls
+
+Parse the fwnode "orientation" and "rotation" properties and expose
+them as V4L2_CID_CAMERA_ORIENTATION and V4L2_CID_CAMERA_SENSOR_ROTATION
+like most other sensor drivers do. libcamera uses them to tell the user
+which camera is the front or back one; without them the OV8856 on the
+Lenovo IdeaPad Duet 3 shows up as a nameless sensor and applications
+cannot pick the front camera by default.
+Signed-off-by: Jesse <jesse@jjo.ninja>
+---
+ drivers/media/i2c/ov8856.c | 10 ++++++++++
+ 1 file changed, 10 insertions(+)
+
+diff --git a/drivers/media/i2c/ov8856.c b/drivers/media/i2c/ov8856.c
+index e43d2c270..e2ed4bc2e 100644
+--- a/drivers/media/i2c/ov8856.c
++++ b/drivers/media/i2c/ov8856.c
+@@ -1895,6 +1895,7 @@ static const struct v4l2_ctrl_ops ov8856_ctrl_ops = {
+ 
+ static int ov8856_init_controls(struct ov8856 *ov8856)
+ {
++	struct v4l2_fwnode_device_properties props;
+ 	struct v4l2_ctrl_handler *ctrl_hdlr;
+ 	s64 exposure_max, h_blank;
+ 	int ret;
+@@ -1964,6 +1965,15 @@ static int ov8856_init_controls(struct ov8856 *ov8856)
+ 		goto err_ctrl_handler_free;
+ 	}
+ 
++	ret = v4l2_fwnode_device_parse(ov8856->dev, &props);
++	if (ret)
++		return ret;
++
++	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &ov8856_ctrl_ops,
++					      &props);
++	if (ret)
++		return ret;
++
+ 	ov8856->sd.ctrl_handler = ctrl_hdlr;
+ 
+ 	return 0;
diff --git a/device/community/linux-postmarketos-qcom-sc7180/0018-dt-bindings-media-i2c-ovti-ov8856-Allow-video-interf.patch b/device/community/linux-postmarketos-qcom-sc7180/0018-dt-bindings-media-i2c-ovti-ov8856-Allow-video-interf.patch
