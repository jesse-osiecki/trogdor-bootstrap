# Wormdingler: panel is native portrait, kwin applies Rotated90, so the stock
# hwdb cros-ec-accel matrix leaves auto-rotation off by 90 degrees.
# Swap x/y and invert x (from the postmarketOS wiki wormdingler page).
ACTION=="remove", GOTO="sensor_end"
SUBSYSTEM=="iio", KERNEL=="iio*", SUBSYSTEMS=="platform", \
  ATTRS{modalias}=="platform:cros-ec-accel", \
  ENV{ACCEL_MOUNT_MATRIX}="0, 1, 0; -1, 0, 0; 0, 0, -1", \
  GOTO="sensor_end"
LABEL="sensor_end"
